declaration scope TestFp041:
  output computation content F.FinalPaycheck

scope TestFp041:
  definition computation equals
    output of F.FinalPaycheck with {
      -- last_day: |2026-03-10|
      -- separation: T.Separation.QuitWithoutNotice
      -- work_state: T.WorkState.CA
      -- next_regular_payroll_date: |2026-03-20|
    }
  assertion computation.due_date = |2026-03-13|
  assertion computation.pto_payout_required = true
