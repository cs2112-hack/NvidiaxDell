#!/usr/bin/env python3
"""lks — the legal knowledge system's command line.

    lks agent status                        the local model and role isolation
    lks agent triage "<DOC CLAUSE>"         propose a label, compare to the ledger
    lks agent facts --scope M.S "<question>"  extract facts, execute nothing
    lks serve [--port 8765]                 the web interface
    lks ask "<question>" [--inputs JSON] [--scope Module.Scope] [--backend mongo|files]
    lks scopes [--grep TEXT]
    lks run <Module.Scope> <JSON>
    lks why <Module.Scope> <variable>
    lks cite <DOC-ID CLAUSE-ID>
    lks index build | sync | status
    lks convert <file> [--doc-id ID] [--title T] [--effective-date YYYY-MM-DD]
    lks ingest <document> [--candidate FILE ...]   (.md .txt .docx .pdf .html)
    lks proposals [--id ID]
    lks merge <proposal-id>
    lks counterexamples [--open]
    lks check
"""
import argparse
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "src"))


def _store(backend: str):
    if backend in ("mongo", "auto"):
        try:
            from lks.mongo_store import MongoVectorStore
            return MongoVectorStore.open()
        except Exception as e:
            if backend == "mongo":
                raise
            print(f"(mongo unavailable: {type(e).__name__}; using the committed files)",
                  file=sys.stderr)
    from lks.vector import VectorStore
    return VectorStore.open()


def cmd_ask(a):
    from lks.chat import Chat
    c = Chat(store=_store(a.backend))
    inputs = json.loads(a.inputs) if a.inputs else None
    print(c.answer(a.question, inputs=inputs, scope=a.scope).render())


def cmd_scopes(a):
    from lks.registry import build_registry, load_registry
    reg = load_registry() or build_registry()
    for k, e in sorted(reg.items()):
        if a.grep and a.grep.lower() not in k.lower() and not any(
            a.grep.lower() in r.lower() for r in e.encodes
        ):
            continue
        print(f"{k}")
        print(f"    inputs   {', '.join(e.inputs) or '-'}")
        print(f"    outputs  {', '.join(e.outputs) or '-'}")
        if e.judgement_inputs:
            print(f"    JUDGEMENT (a human must supply): {', '.join(e.judgement_inputs)}")
        print(f"    encodes  {', '.join(e.encodes) or '-'}")


def cmd_run(a):
    from lks.catala_runner import CatalaError, run_scope
    from lks.registry import build_registry, load_registry
    reg = load_registry() or build_registry()
    e = reg.get(a.target)
    if e is None:
        print(f"no such scope: {a.target}. Try: lks scopes", file=sys.stderr)
        return 1
    try:
        print(json.dumps(run_scope(e.path, e.scope, json.loads(a.inputs)), indent=2, sort_keys=True))
    except CatalaError as ex:
        print(f"{type(ex).__name__}: {ex.diagnostic}", file=sys.stderr)
        return 1
    return 0


def cmd_why(a):
    """Show the exception hierarchy the compiler actually built."""
    from lks.catala_runner import exception_tree, tree_signature
    from lks.registry import build_registry, load_registry
    reg = load_registry() or build_registry()
    e = reg.get(a.target)
    if e is None:
        print(f"no such scope: {a.target}", file=sys.stderr)
        return 1
    trees = exception_tree(e.path, e.scope, a.variable)
    print(f"{a.target}.{a.variable} — exception hierarchy as compiled:")
    print(tree_signature(trees))
    return 0


def cmd_cite(a):
    from lks.segment import load_corpus
    ref = " ".join(a.ref)
    for d in load_corpus("corpus"):
        for c in d.clauses:
            if c.ref == ref:
                print(f"{c.cite()}  [{d.title} v{d.version}, effective {d.effective_date}]")
                print(f"Section {c.section_id} {c.section_title}\n")
                print(c.body)
                return 0
    print(f"no clause {ref!r} in the corpus", file=sys.stderr)
    return 1


def cmd_index(a):
    if a.action == "build":
        from lks.vector import build_index
        print(json.dumps(build_index(), indent=2))
    elif a.action == "sync":
        from lks.mongo_store import sync
        print(json.dumps(sync(), indent=2))
    else:
        from lks.vector import VectorStore
        s = VectorStore.open()
        print(json.dumps({"files": s.manifest}, indent=2))
        try:
            from lks.mongo_store import MongoVectorStore
            m = MongoVectorStore.open()
            print(json.dumps({"mongo": m.status()}, indent=2))
            m.close()
        except Exception as e:
            print(f"mongo: unavailable ({type(e).__name__})")
    return 0


def _overrides(a):
    """Metadata the document does not state, supplied by hand."""
    return {k: getattr(a, k, None) for k in
            ("doc_id", "title", "version", "effective_date", "jurisdiction", "owner")
            if getattr(a, k, None)}


def cmd_convert(a):
    """Convert a real document to the house convention, for a human to check."""
    from lks.extract import ExtractionError, capabilities
    from lks.structure import convert_file

    if a.formats:
        print(json.dumps(capabilities(), indent=2))
        return 0
    if not a.file:
        print("lks convert <file> [--doc-id ID] [--title T] "
              "[--effective-date YYYY-MM-DD]\n"
              "       lks convert --formats   (what this installation can read)",
              file=sys.stderr)
        return 2
    try:
        c = convert_file(a.file, out_dir=a.out_dir, overrides=_overrides(a))
    except ExtractionError as e:
        print(f"cannot read {a.file}: {e}", file=sys.stderr)
        return 1
    s = c.structured
    print(f"{a.file}  ->  {c.converted_path}")
    print(f"  format        {s.extracted.fmt} (read with {s.extracted.tool})")
    print(f"  scheme        {s.scheme.describe()}")
    print(f"                {s.scheme.evidence['why']}")
    print(f"  paragraphs    {s.extracted.n_paras} in, all accounted for in the report")
    print(f"  clauses       {len(s.clauses)}  "
          f"({len(s.clauses) - len(s.synthesised)} ids from the document, "
          f"{len(s.synthesised)} synthesised)")
    if s.synthesised:
        print(f"  SYNTHESISED   {', '.join(c2.clause_id for c2 in s.synthesised)}")
        print( "                these ids are positional and CANNOT be cited")
    if s.unassigned:
        print(f"  UNASSIGNED    {len(s.unassigned)} paragraph(s) could not be placed: "
              f"{[d.index for d in s.unassigned]}")
    if s.furniture:
        print(f"  furniture     {len(s.furniture)} paragraph(s) left out as page "
              f"headers/footers: {[d.index for d in s.furniture]}")
    for f, v in s.meta.items():
        if v == "NEEDS-HUMAN-INPUT":
            print(f"  NEEDS HUMAN   {f}: {s.needs_human.get(f, '')}")
    print(f"  report        {c.report_path}")
    print("\nRead the report, then the converted document. Neither is merged: run "
          "`lks ingest` on the converted file (or on the original) to open a "
          "proposal.")
    return 0


def cmd_ingest(a):
    from lks.ingest import propose_ingestion
    pr = propose_ingestion(a.document, candidate_paths=a.candidate or [],
                           overrides=_overrides(a))
    if pr.conversion:
        print(f"converted {pr.original_path} -> {pr.source_path} "
              f"({pr.conversion['scheme']}); report "
              f"{pr.conversion['report_path']}")
    print(f"proposal {pr.id}: {len(pr.conflicts)} conflict(s), "
          f"{len(pr.blocking)} blocking, mergeable={pr.mergeable}")
    for c in pr.conflicts:
        print(f"  [{c.severity}] {c.kind}  {c.incoming_ref}")
        print(f"      {c.detail.splitlines()[0]}")
    print(f"\nwritten to {pr.dir / 'proposal.yaml'}")
    if not pr.mergeable:
        print("Merge is refused until a human records a resolution and resolved_by "
              "against each blocking conflict in that file.")
    return 0


def cmd_proposals(a):
    from lks.ingest import PROPOSALS, Proposal
    if not PROPOSALS.exists():
        print("no proposals")
        return 0
    for d in sorted(PROPOSALS.iterdir()):
        if not (d / "proposal.yaml").exists():
            continue
        pr = Proposal.load(d.name)
        if a.id and a.id != pr.id:
            continue
        print(f"{pr.id}  {pr.doc_id}  {'mergeable' if pr.mergeable else 'BLOCKED'}  "
              f"({len(pr.unresolved)} unresolved of {len(pr.blocking)} blocking)")
    return 0


def cmd_merge(a):
    from lks.ingest import MergeRefused, merge
    try:
        print(json.dumps(merge(a.id), indent=2))
    except MergeRefused as e:
        print(str(e), file=sys.stderr)
        return 1
    return 0


def cmd_counterexamples(a):
    from lks.counterexample import load_all, summary
    for ce in load_all():
        if a.open_only and ce.status != "open":
            continue
        print(f"{ce.id}  [{ce.status}]  round {ce.round}  "
              f"{ce.target.get('module','')}.{ce.target.get('scope','')}")
        print(f"    {ce.fact_pattern.splitlines()[0][:100]}")
        print(f"    cites {', '.join(ce.citations)}")
    print(f"\n{json.dumps(summary())}")
    return 0


def cmd_agent(a):
    from lks import agents, llm
    if a.action == "status":
        print(f"model     {llm.DEFAULT_MODEL}")
        print(f"host      {llm.OLLAMA_HOST}")
        try:
            tags = llm.available()
            names = sorted(m.get("name", "") for m in tags.get("models", []))
            print(f"ollama    reachable; models: {', '.join(names) or '(none)'}")
        except llm.ModelUnavailable as e:
            print(f"ollama    NOT reachable — {e}")
        enf = agents.REVIEWER.enforcement()
        print(f"isolation {enf}")
        if enf == agents.Enforcement.PROMPT:
            print("          OpenShell absent: a role is only ASKED not to read what it")
            print("          must not see. Packets are still stripped, but the boundary")
            print("          is not enforced by the filesystem.")
        print()
        for name, r in agents.ROLES.items():
            print(f"  {name}")
            print(f"      {r.purpose}")
            print(f"      may read : {', '.join(r.reads) or '(nothing from the repo)'}")
            print(f"      must not : {', '.join(r.forbidden)}")
            for prob in agents.audit_isolation(r):
                print(f"      PROBLEM  {prob}")
        return 0

    if a.action == "triage":
        from lks.segment import load_corpus
        from lks.triage import load_ledger
        ref = " ".join(a.args)
        clause = None
        for d in load_corpus("corpus"):
            for cl in d.clauses:
                if cl.ref == ref:
                    clause = cl
        if clause is None:
            print(f"no clause {ref!r}", file=sys.stderr)
            return 1
        res = agents.triage_clause(clause)
        print(res)
        if res.ok:
            truth = load_ledger().get(ref)
            print(f"  model     {res.value['label']}  {res.value['reason']}")
            if res.value["judgement_inputs"]:
                print(f"  judgement {res.value['judgement_inputs']}")
            if truth:
                mark = "agrees" if truth.label.value == res.value["label"] else "DISAGREES"
                print(f"  ledger    {truth.label.value}  ({mark})")
        return 0 if res.ok else 1

    if a.action == "facts":
        from lks.catala_runner import json_schema
        from lks.registry import build_registry, load_registry
        reg = load_registry() or build_registry()
        e = reg.get(a.scope)
        if e is None:
            print(f"no scope {a.scope!r}; try: lks scopes", file=sys.stderr)
            return 1
        in_schema, _ = json_schema(e.path, e.scope)
        types = {}
        defs = in_schema.get("definitions", {})
        root = defs.get(in_schema.get("$ref", "").split("/")[-1], {})
        for n, spec in (root.get("properties") or {}).items():
            r = spec.get("$ref", "")
            types[n] = r.split("/")[-1] if r else spec.get("type", "unknown")
        res = agents.extract_facts(" ".join(a.args), types)
        print(res)
        if res.ok:
            print(f"  extracted: {json.dumps(res.value['facts'], indent=2)}")
            if res.value["omitted"]:
                print(f"  a person must supply: {', '.join(res.value['omitted'])}")
            print("  Nothing was executed. Check these, then: lks run "
                  f"{a.scope} '<json>'")
        return 0 if res.ok else 1
    return 0


def cmd_serve(a):
    from lks.api import serve
    serve(a.host, a.port)
    return 0


def cmd_check(a):
    import subprocess
    return subprocess.call([str(ROOT / "scripts" / "check.sh")], cwd=str(ROOT))


def main() -> int:
    p = argparse.ArgumentParser(prog="lks", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    q = sub.add_parser("ask", help="answer a question over both engines")
    q.add_argument("question")
    q.add_argument("--inputs", help="JSON object of scope inputs")
    q.add_argument("--scope", help="force a scope, e.g. Overtime.HourPremium")
    q.add_argument("--backend", default="auto", choices=["auto", "mongo", "files"])
    q.set_defaults(fn=cmd_ask)

    s = sub.add_parser("scopes", help="list rule scopes and what they need")
    s.add_argument("--grep")
    s.set_defaults(fn=cmd_scopes)

    r = sub.add_parser("run", help="execute a scope directly")
    r.add_argument("target"); r.add_argument("inputs")
    r.set_defaults(fn=cmd_run)

    w = sub.add_parser("why", help="print a variable's exception hierarchy")
    w.add_argument("target"); w.add_argument("variable")
    w.set_defaults(fn=cmd_why)

    c = sub.add_parser("cite", help="print a clause verbatim with its citation")
    c.add_argument("ref", nargs="+")
    c.set_defaults(fn=cmd_cite)

    i = sub.add_parser("index", help="build, sync or inspect the vector index")
    i.add_argument("action", choices=["build", "sync", "status"])
    i.set_defaults(fn=cmd_index)

    def _meta_args(sp):
        """Front-matter values a real document may not state."""
        sp.add_argument("--doc-id", dest="doc_id")
        sp.add_argument("--title")
        sp.add_argument("--version")
        sp.add_argument("--effective-date", dest="effective_date",
                        help="YYYY-MM-DD; never guessed from the text")
        sp.add_argument("--jurisdiction")
        sp.add_argument("--owner")

    cv = sub.add_parser("convert", help="convert a real document (.txt .md .docx "
                                        ".pdf .html) to the house convention")
    cv.add_argument("file", nargs="?")
    cv.add_argument("--out-dir", default="ingest/converted")
    cv.add_argument("--formats", action="store_true",
                    help="print the formats this installation can read, and stop")
    _meta_args(cv)
    cv.set_defaults(fn=cmd_convert)

    g = sub.add_parser("ingest", help="propose ingestion of a new document")
    g.add_argument("document"); g.add_argument("--candidate", action="append")
    _meta_args(g)
    g.set_defaults(fn=cmd_ingest)

    pl = sub.add_parser("proposals", help="list ingestion proposals")
    pl.add_argument("--id")
    pl.set_defaults(fn=cmd_proposals)

    m = sub.add_parser("merge", help="merge a proposal (refused while conflicts remain)")
    m.add_argument("id")
    m.set_defaults(fn=cmd_merge)

    ce = sub.add_parser("counterexamples", help="list the permanent regression suite")
    ce.add_argument("--open", dest="open_only", action="store_true")
    ce.set_defaults(fn=cmd_counterexamples)

    ag = sub.add_parser("agent", help="the local model and its roles")
    ag.add_argument("action", choices=["status", "triage", "facts"])
    ag.add_argument("args", nargs="*")
    ag.add_argument("--scope", default="", help="for 'facts': the scope to fill")
    ag.set_defaults(fn=cmd_agent)

    sv = sub.add_parser("serve", help="run the local web interface")
    sv.add_argument("--host", default="127.0.0.1")
    sv.add_argument("--port", type=int, default=8765)
    sv.set_defaults(fn=cmd_serve)

    ck = sub.add_parser("check", help="run the full verification gate")
    ck.set_defaults(fn=cmd_check)

    a = p.parse_args()
    return a.fn(a) or 0


if __name__ == "__main__":
    raise SystemExit(main())
