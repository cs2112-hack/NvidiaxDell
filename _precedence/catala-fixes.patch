diff --git a/compiler/surface/lexer.cppo.ml b/compiler/surface/lexer.cppo.ml
index bec75678..80520eb1 100644
--- a/compiler/surface/lexer.cppo.ml
+++ b/compiler/surface/lexer.cppo.ml
@@ -421,6 +421,32 @@ let check_fence_space =
     Message.warning ~pos:(Pos.from_lpos (lexing_positions lexbuf))
       "Extra leading or trailing space"
 
+(* Warn when a fenced block is labelled like a Catala block but is not one of
+   the two recognised labels: such a block is silently treated as plain law
+   text, which means the code inside it never reaches the compiler. *)
+let check_unrecognised_catala_fence =
+  let fence_re =
+    Re.(compile @@ seq [bos; rep space; str "```"; group (rep (alt [alnum; char '-'; char '_']))])
+  in
+  fun lexbuf ->
+    let txt = Utf8.lexeme lexbuf in
+    match Re.exec_opt fence_re txt with
+    | None -> ()
+    | Some g ->
+      let label = Re.Group.get g 1 in
+      let low = String.lowercase_ascii label in
+      if String.starts_with ~prefix:"catala" low
+         && label <> "catala"
+         && label <> "catala-metadata"
+         && label <> "catala-test-cli"
+      then
+        Message.warning ~pos:(Pos.from_lpos (lexing_positions lexbuf))
+          "Unrecognised code block label @{<yellow>```%s@}: this block is \
+           treated as plain text, so any code inside it is ignored.@\n\
+           Did you mean @{<yellow>```catala@} or \
+           @{<yellow>```catala-metadata@} ?"
+          label
+
 let rec lex_string buf lexbuf : token =
   match%sedlex lexbuf with
   | Plus (Compl (Chars "\\\"")) ->
@@ -911,6 +937,7 @@ let lex_law (lexbuf : lexbuf) : token =
         BEGIN_METADATA
     | Star hspace, "```", Star (idchar | '-') ->
         check_fence_space lexbuf;
+        check_unrecognised_catala_fence lexbuf;
         L.context := Raw;
         L.context_start_pos := lexing_positions lexbuf;
         LAW_TEXT (Utf8.lexeme lexbuf)
