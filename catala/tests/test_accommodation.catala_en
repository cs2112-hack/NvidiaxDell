      -- city_tier: ExpenseDefs.CityTier.Tier1
      -- room_cost: $308.00
      -- local_taxes: $0.00
      -- mandatory_resort_or_city_charge: $0.00
      -- parking_cost: $0.00
      -- no_compliant_accommodation_available_evidenced: true
    }
  assertion r.accommodation_reimbursable = $308.00
```

## E4_2_EvidencedAPennyAboveUpliftedCap

